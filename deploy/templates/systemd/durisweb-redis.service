[Unit]
Description=DurisWeb private Redis cache
Wants=network-online.target
After=network-online.target
Before=@APPLICATION_SERVICE@
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=@BACKEND_ENV_FILE@
Environment=LD_LIBRARY_PATH=@REDIS_LIBRARY_PATH@
ExecStart=@REDIS_BIN@ @REDIS_CONFIG_PATH@ --requirepass ${CACHE_REDIS_PASSWORD}
Restart=always
RestartSec=5s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30s
UMask=0077
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@REDIS_DATA_DIR@
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=durisweb-redis

[Install]
WantedBy=default.target
