# This unconfined profile preserves the host-wide user-namespace restriction while allowing the
# configured bubblewrap executable to create the namespace that enforces the terminal sandbox.

abi <abi/4.0>,
include <tunables/global>

profile durisweb-bwrap /usr/bin/bwrap flags=(unconfined,attach_disconnected) {
  userns,

  include if exists <local/durisweb-bwrap>
}
