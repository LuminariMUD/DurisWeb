[Unit]
Description=DurisWeb production API and static frontend
Wants=network-online.target duris-mariadb.service
Requires=durisweb-redis.service
After=network-online.target duris-mariadb.service duris-mud-production.service durisweb-redis.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/duris/durisweb/backend
EnvironmentFile=/home/duris/durisweb/backend/.env
Environment=PATH=/home/duris/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/test -r /home/duris/durisweb/backend/dist/index.js
ExecStartPre=/usr/bin/test -r /home/duris/durisweb/frontend/dist/index.html
ExecCondition=/home/duris/.local/bin/node /home/duris/durisweb/backend/dist/scripts/productionPreflight.js
ExecStart=/home/duris/.local/bin/node /home/duris/durisweb/backend/dist/index.js
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=90s
TimeoutStopSec=30s
UMask=0077
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RemoveIPC=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=durisweb-production

[Install]
WantedBy=default.target
