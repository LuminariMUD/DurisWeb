# Explicit test configuration. Copy to .env.test and replace database access
# only when running tests that connect to MySQL.
# Lifecycle metadata native qualification has its own isolated databases/users:
# TEST_LIFECYCLE_METADATA_DB_PORTS=23436,23437 (dedicated disposable services only).
# Retention/hold fixtures require the explicit DBA-owned read-only metadata helper;
# see docs/runbooks/lifecycle-metadata.md. No extra runtime credential is needed.
NODE_ENV=test
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://frontend.test.invalid
LOG_LEVEL=error
SITE_URL=http://site.test.invalid
JWT_SECRET=test-jwt-secret-at-least-32-bytes-long

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME_TEST_DATABASE_USER
DB_PASSWORD=CHANGE_ME_TEST_DATABASE_PASSWORD
DB_NAME=CHANGE_ME_TEST_DATABASE_NAME
MUD_DATABASE_MODE=shared

MUD_DIR=/tmp/durisweb-test-mud
MUD_WS_URL=ws://127.0.0.1:4050
MUD_PROCESS_USER=duris-test
MUD_PROCESS_HOME=/tmp/durisweb-test-mud
MUD_PROCESS_PATH=/usr/local/bin:/usr/bin:/bin
MUD_PROCESS_LOCALE=C.UTF-8
MUD_PROCESS_SHELL=/bin/bash
MUD_SETSID_BIN=/usr/bin/setsid
TERMINAL_SANDBOX_BIN=/usr/bin/bwrap
DB_PASSWD=test-mud-database-password
DURISWEB_SECRET=test-bridge-secret-at-least-32-bytes
BACKUP_DIR=/tmp/durisweb-test-backups

CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_REDIS_AUTH_MODE=none
CACHE_REDIS_TLS=false

MUD_REDIS_ENABLED=false
DONATIONS_ENABLED=false
ENABLE_GUILD_SYNC=false
R2_ENABLED=false
PUSH_ENABLED=false
GEMINI_ENABLED=false

# Prevent fallback to production Discord credentials during tests.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Native privacy tests require a deliberately provisioned disposable full-schema
# fixture named durisweb_qualification_privacy_suite on loopback port 23436/23437.
# Leave unset for ordinary unit tests; it is independent of hook/session opt-ins.
# TEST_PRIVACY_DB_PORT=23436

# Native image removal tests require a deliberately provisioned full-schema
# fixture named durisweb_qualification_image_suite on loopback port 23436/23437.
# TEST_IMAGE_DB_PORT=23436

# Native read-only retention previews use a separately provisioned full-schema
# fixture durisweb_qualification_retention_suite on loopback port 23436/23437.
# TEST_RETENTION_DB_PORT=23436

# Native hold/API tests use the independent full-schema disposable database
# durisweb_qualification_hold_suite on loopback port 23436/23437.
# TEST_DATA_HOLD_DB_PORT=23436

# Execution qualification: exact database durisweb_qualification_retention_execution_suite,
# loopback 23436/23437 and dedicated cache 23479 DB 13/14 respectively.
# TEST_RETENTION_EXECUTION_DB_PORT=23436

# Managed archive qualification: its own full-schema database
# durisweb_qualification_archive_removal_suite, loopback 23436/23437,
# owned /tmp/durisweb-archive-qualification-* directory and cache 23479 DB 13/14.
# TEST_ARCHIVE_REMOVAL_DB_PORT=23436
