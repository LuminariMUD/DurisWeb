        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_auction_close",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: Auction close and settlement events from the MUD.",
        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_auction_new",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: New auction listings broadcast from the MUD.",
        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_connection_log",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: Dormant legacy parser for connection records in the MUD comm log. Authenticated bridge events are the active ingestion path; retaining this website-side toggle does not restart the tail or stop MUD logging.",
        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_donation_delivery",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: Signed donation events delivered to the MUD over scoped Redis. The MUD side gates application on the game-thread runtime pump, not the Redis worker.",
        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_flag_parsing",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: Builder flag definitions read from MUD source files. Website-side read; the MUD has no emitter to gate.",
        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_guild_parsing",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: Database-backed guild compatibility facade and background forum sync. The stable flatfile-era id is retained, but availability is independent of MUD_DIR and the MUD has no emitter to gate.",
        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_mud_shutdown",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: MUD shutdown and crash notifications.",
        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_player_presence",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: Player login and logout presence. One hook covers both MUD emitters; presence also has a Redis current-state feed read by onlinePlayersService. Payloads omit account names and IPs unless DURISWEB_PRIVATE_PRESENCE is TRUE.",
        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_process_control",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: Start, stop, and reboot of the MUD process from the website. Gated by the mud_control permission; the MUD has no in-process side to toggle.",
        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_wholist",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: Online player list served in response to request_wholist. Registered on the response, which is what an operator would cut.",
        "updated_by": null
      },
      {
        "setting_key": "hook_enabled_zone_builder_parsing",
        "setting_value": "true",
        "description": "DurisWeb hook toggle: Zone and area files parsed for the builder tools. Website-side read; the MUD has no emitter to gate.",
        "updated_by": null
      },
