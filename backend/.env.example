# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================
# These values are REQUIRED and have no defaults.
# The application will fail to start if these are not set.
#
# For Development: Use your local development database
# For Production: Use your production database credentials
#
DB_HOST=127.0.0.1
DB_USER=duris
DB_PASSWORD=duris
DB_NAME=duris_dev
DB_PORT=3306

# Server Configuration
PORT=3001
NODE_ENV=development

# Host binding (optional)
# Development: Defaults to 'localhost' (only accessible from same machine)
# Production: Defaults to '0.0.0.0' (accessible from network)
# Override with HOST=0.0.0.0 to expose on all interfaces
# HOST=0.0.0.0

# CORS Configuration (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ============================================================================
# JWT Configuration (REQUIRED for production)
# ============================================================================
# IMPORTANT: Generate a strong random secret for production!
# Example: openssl rand -base64 64
#
JWT_SECRET=your-secret-key-here-change-in-production

# MUD Configuration
MUD_DIR=/path/to/DurisMUD
MUD_ACCOUNTS_DIR=/path/to/DurisMUD/Accounts

# ============================================================================
# MUD Process Environment Variables (passed when starting MUD via web)
# ============================================================================
# These are passed to the MUD process when started via web control panel.
# DB_PASSWD is used by MUD C code (different from DB_PASSWORD used by backend)
#
DB_PASSWD=duris
DURISWEB_SECRET=your-gmcp-secret-here

# ============================================================================
# Gemini AI Configuration (OPTIONAL)
# ============================================================================
# For AI-powered suspicious activity analysis
# Get a FREE API key at: https://aistudio.google.com/app/apikey
# Free tier: 1,500 requests/day, 1M tokens/min (more than enough for MUD)
# Leave blank to disable AI analysis feature
#
# GEMINI_API_KEY=your_free_api_key_here

# ============================================================================
# Backup Configuration (OPTIONAL)
# ============================================================================
# Directory for storing backup files
# Defaults to ./backups relative to the backend directory
#
# BACKUP_DIR=/path/to/backups

# ============================================================================
# Cloudflare R2 Storage Configuration (OPTIONAL)
# ============================================================================
# For profile picture uploads
# Create API tokens at: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# Select "Object Read & Write" permission, scope to bucket only
# Leave blank to disable avatar upload feature
#
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET_NAME=durisweb
# R2_PUBLIC_URL=https://your-public-domain.com

# ============================================================================
# Web Push (VAPID) Configuration (OPTIONAL)
# ============================================================================
# For PWA push notifications
# Generate keys with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications
#
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:admin@your-domain.com

# ============================================================================
# Ko-fi Webhook Configuration (OPTIONAL)
# ============================================================================
# For receiving Ko-fi donation webhooks
# Get your verification token from: Ko-fi > Settings > Webhooks > Advanced
#
# KOFI_VERIFICATION_TOKEN=your-verification-token
