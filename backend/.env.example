# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================
# These values are REQUIRED and have no defaults.
# The application will fail to start if these are not set.

# Server Configuration
#   development - Localhost binding, development error details, normal server startup
#   test - Loads .env.test and prevents the HTTP server from listening
#   production - Production static serving, secure cookies, production Redis requirements, 0.0.0.0 default binding
PORT=3001
NODE_ENV=development

# For Development: Use your local development database
# For Production: Use your production database credentials

DB_HOST=127.0.0.1
DB_USER=duris
DB_PASSWORD=duris
DB_NAME=duris_dev
DB_PORT=3306

# Optional authoritative MUD read database for donation account/character
# matching and season-epoch lookup. If omitted, the WebService database is
# used for backward-compatible same-database deployments.
# MUD_DB_HOST=127.0.0.1
# MUD_DB_USER=duris_readonly
# MUD_DB_PASSWORD=replace-with-a-secret
# MUD_DB_NAME=duris
# MUD_DB_PORT=3306

# Host binding (optional)
# Development: Defaults to 'localhost' (only accessible from same machine)
# Production: Defaults to '0.0.0.0' (accessible from network)
# Override with HOST=0.0.0.0 to expose on all interfaces
# HOST=0.0.0.0

# CORS Configuration (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ============================================================================
# JWT Configuration (REQUIRED for production)
# ============================================================================
# IMPORTANT: Generate a strong random secret for production!
# Example: openssl rand -base64 64
#
JWT_SECRET=your-secret-key-here-change-in-production

# MUD Configuration
# Same-host production checkout and account data root.
MUD_DIR=/home/duris/duris
MUD_ACCOUNTS_DIR=/home/duris/duris/Accounts
# Same-host production default. Use wss:// only when a TLS endpoint is explicitly configured.
# MUD_WS_URL=ws://127.0.0.1:4050

# ============================================================================
# Backend/MUD service authentication (REQUIRED for the privileged bridge)
# ============================================================================
# This secret is read by the backend service and the MUD service listener.
# Never place it in frontend/.env, VITE_ variables, browser code, or logs.
# Generate a high-entropy value and rotate with the MUD's previous-key procedure.
DURISWEB_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Previous key is optional during a bounded rotation grace window.
# DURISWEB_SECRET_PREVIOUS=replace-with-the-previous-random-secret
# Optional ISO-8601 timestamp used only to show secret age in the admin console.
# DURISWEB_SECRET_ROTATED_AT=2026-09-01T00:00:00Z

# ============================================================================
# Redis donation event delivery (OPTIONAL; disabled until fully configured)
# ============================================================================
# The publisher uses the existing Redis host/port/database with a dedicated
# donation ACL identity in production. REDIS_NAMESPACE must match the MUD's
# active deployment namespace exactly.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_TLS=TRUE
# REDIS_CA_CERT=/etc/ssl/certs/redis-ca.pem
# REDIS_TLS_SERVER_NAME=redis.example.internal
# REDIS_NAMESPACE=duris:production:replace-me
# REDIS_DONATION_USERNAME=duris_donation_publisher
# REDIS_DONATION_PASSWORD=replace-with-a-secret
# REDIS_DONATION_SECRET=replace-with-a-random-secret-at-least-32-bytes
# REDIS_PRESENCE_USERNAME=duris_presence_reader
# REDIS_PRESENCE_PASSWORD=replace-with-a-secret
# REDIS_CACHE_USERNAME=duris_cache_reader
# REDIS_CACHE_PASSWORD=replace-with-a-secret

# ============================================================================
# MUD Process Environment Variables (passed when starting MUD via web)
# ============================================================================
# DB_PASSWD is used by MUD C code (different from DB_PASSWORD used by backend)
# These values are only used by the web-controlled MUD process launcher.
#
DB_PASSWD=duris

# ============================================================================
# Gemini AI Configuration (OPTIONAL)
# ============================================================================
# For AI-powered suspicious activity analysis
# Get a FREE API key at: https://aistudio.google.com/app/apikey
# Free tier: 1,500 requests/day, 1M tokens/min (more than enough for MUD)
# Leave blank to disable AI analysis feature
#
# GEMINI_API_KEY=your_free_api_key_here

# ============================================================================
# Backup Configuration (OPTIONAL)
# ============================================================================
# Directory for storing backup files
# Defaults to ./backups relative to the backend directory
#
# BACKUP_DIR=/path/to/backups

# ============================================================================
# Cloudflare R2 Storage Configuration (OPTIONAL)
# ============================================================================
# For profile picture uploads
# Create API tokens at: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# Select "Object Read & Write" permission, scope to bucket only
# Leave blank to disable avatar upload feature
#
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET_NAME=durisweb
# R2_PUBLIC_URL=https://your-public-domain.com

# ============================================================================
# Web Push (VAPID) Configuration (OPTIONAL)
# ============================================================================
# For PWA push notifications
# Generate keys with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications
#
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:admin@your-domain.com

# ============================================================================
# Ko-fi Webhook Configuration (OPTIONAL)
# ============================================================================
# For receiving Ko-fi donation webhooks
# Get your verification token from: Ko-fi > Settings > Webhooks > Advanced
#
# KOFI_VERIFICATION_TOKEN=your-verification-token

# Cloudflare credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
