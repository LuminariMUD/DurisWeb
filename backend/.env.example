# DurisWeb backend environment
# Copy to .env and replace every CHANGE_ME value. No deployment value below
# has an application fallback. Startup and production preflight report all
# missing or invalid keys without printing secret values.

# Core HTTP runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173
LOG_LEVEL=info
SITE_URL=http://127.0.0.1:5173
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# WebService database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME_WEB_DATABASE_USER
DB_PASSWORD=CHANGE_ME_WEB_DATABASE_PASSWORD
DB_NAME=CHANGE_ME_WEB_DATABASE_NAME

# Authoritative MUD database ownership
# Use shared only when both applications intentionally use the same database.
# Use separate and configure all MUD_DB_* keys for an independent read target.
MUD_DATABASE_MODE=shared
# MUD_DB_HOST=mud-db.example.invalid
# MUD_DB_PORT=3306
# MUD_DB_USER=CHANGE_ME_MUD_READ_USER
# MUD_DB_PASSWORD=CHANGE_ME_MUD_READ_PASSWORD
# MUD_DB_NAME=CHANGE_ME_MUD_DATABASE_NAME

# MUD checkout, privileged bridge, and process launcher
MUD_DIR=/srv/CHANGE_ME/durismud
MUD_WS_URL=ws://127.0.0.1:4050
MUD_PROCESS_USER=CHANGE_ME_SERVICE_ACCOUNT
MUD_PROCESS_HOME=/srv/CHANGE_ME
MUD_PROCESS_PATH=/usr/local/bin:/usr/bin:/bin
MUD_PROCESS_LOCALE=C.UTF-8
MUD_PROCESS_SHELL=/bin/bash
MUD_SETSID_BIN=/usr/bin/setsid
TERMINAL_SANDBOX_BIN=/usr/bin/bwrap
DB_PASSWD=CHANGE_ME_MUD_PROCESS_DATABASE_PASSWORD
DURISWEB_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
# DURISWEB_SECRET_PREVIOUS=CHANGE_ME_WITH_THE_PREVIOUS_32_BYTE_SECRET
# DURISWEB_SECRET_ROTATED_AT=2026-09-02T00:00:00Z

# Backups
BACKUP_DIR=/srv/CHANGE_ME/durisweb-backups

# General writable DurisWeb cache (always required)
# Authentication modes: none, password, acl. Production refuses none.
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_REDIS_AUTH_MODE=password
# CACHE_REDIS_USERNAME=CHANGE_ME_CACHE_ACL_USER
CACHE_REDIS_PASSWORD=CHANGE_ME_CACHE_PASSWORD
CACHE_REDIS_TLS=false
# CACHE_REDIS_CA_CERT=/etc/ssl/certs/CHANGE_ME_cache_ca.pem
# CACHE_REDIS_TLS_SERVER_NAME=cache.example.invalid

# MUD Redis integration for player presence and shared read caches
# When enabled, every connection value is required. Production requires acl.
MUD_REDIS_ENABLED=false
# MUD_REDIS_HOST=mud-redis.example.invalid
# MUD_REDIS_PORT=6379
# MUD_REDIS_DB=0
# MUD_REDIS_NAMESPACE=duris:local:CHANGE_ME
# MUD_REDIS_AUTH_MODE=none
# MUD_REDIS_PRESENCE_USERNAME=CHANGE_ME_PRESENCE_READER
# MUD_REDIS_PRESENCE_PASSWORD=CHANGE_ME_PRESENCE_PASSWORD
# MUD_REDIS_CACHE_USERNAME=CHANGE_ME_MUD_CACHE_READER
# MUD_REDIS_CACHE_PASSWORD=CHANGE_ME_MUD_CACHE_PASSWORD
# MUD_REDIS_TLS=false
# MUD_REDIS_CA_CERT=/etc/ssl/certs/CHANGE_ME_mud_redis_ca.pem
# MUD_REDIS_TLS_SERVER_NAME=mud-redis.example.invalid

# Ko-fi donation ingestion and MUD delivery
# Requires MUD_REDIS_ENABLED=true. With MUD_REDIS_AUTH_MODE=acl, the scoped
# donation identity is also required.
DONATIONS_ENABLED=false
# KOFI_VERIFICATION_TOKEN=CHANGE_ME_PROVIDER_TOKEN
# MUD_REDIS_DONATION_USERNAME=CHANGE_ME_DONATION_PUBLISHER
# MUD_REDIS_DONATION_PASSWORD=CHANGE_ME_DONATION_PASSWORD
# MUD_REDIS_DONATION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# Guild synchronization
ENABLE_GUILD_SYNC=false

# Cloudflare R2 object storage
R2_ENABLED=false
# R2_ACCOUNT_ID=CHANGE_ME_ACCOUNT_ID
# R2_ACCESS_KEY_ID=CHANGE_ME_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=CHANGE_ME_SECRET_ACCESS_KEY
# R2_BUCKET_NAME=CHANGE_ME_BUCKET_NAME
# R2_PUBLIC_URL=https://static.example.invalid

# Browser push notifications
PUSH_ENABLED=false
# VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
# VAPID_SUBJECT=mailto:operator@example.invalid

# Gemini-assisted account analysis
GEMINI_ENABLED=false
# GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
