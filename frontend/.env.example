# env.example - copy as .env and fill in the values for your environment

# Server Configuration
#   development - Localhost binding, development error details, normal server startup
#   test - Loads .env.test and prevents the HTTP server from listening
#   production - Production static serving, secure cookies, production Redis requirements, 0.0.0.0 default binding
PORT=3001
NODE_ENV=development

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# The browser MUD client identifies itself with non-privileged Client.Info.
# The privileged DURISWEB_SECRET belongs only to the backend service environment.
VITE_STATIC_URL=https://static2.resakse.com

# Cloudflare credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
