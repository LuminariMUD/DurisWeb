# DurisWeb frontend build and development environment
# Copy to .env and replace every example.invalid hostname. VITE_* values are
# embedded in browser assets and must never contain secrets.

VITE_BASE_URL=/
VITE_API_URL=https://api.change-me.invalid
VITE_WS_URL=wss://websocket.change-me.invalid/ws
VITE_STATIC_URL=https://static.change-me.invalid

# Vite development and preview server settings
FRONTEND_DEV_HOST=127.0.0.1
FRONTEND_DEV_PORT=5173
FRONTEND_PREVIEW_HOST=127.0.0.1
FRONTEND_PREVIEW_PORT=4173
FRONTEND_ALLOWED_HOSTS=change-me.invalid
