[Unit]
Description=DurisWeb Frontend Server
After=network.target durisweb-backend.service
Wants=durisweb-backend.service

[Service]
Type=simple
User=resakse
Group=resakse
WorkingDirectory=/home/resakse/DurisWeb/frontend
Environment="NODE_ENV=production"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# Load environment variables from .env file (if exists)
EnvironmentFile=-/home/resakse/DurisWeb/frontend/.env

# Serve the built static files
ExecStart=/usr/bin/npx serve -s dist -l 5173

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=durisweb-frontend

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
