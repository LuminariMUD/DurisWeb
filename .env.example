# Local Docker Compose dependencies. Copy to .env and replace every value.
# Keep backend/.env database/cache credentials and ports aligned with this file.
COMPOSE_MYSQL_IMAGE=mysql:8.0
COMPOSE_MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD
COMPOSE_MYSQL_USER=CHANGE_ME_WEB_DATABASE_USER
COMPOSE_MYSQL_PASSWORD=CHANGE_ME_WEB_DATABASE_PASSWORD
COMPOSE_MYSQL_DATABASE=CHANGE_ME_WEB_DATABASE_NAME
COMPOSE_MYSQL_BIND_ADDRESS=127.0.0.1
COMPOSE_MYSQL_HOST_PORT=3306
COMPOSE_MYSQL_HEALTHCHECK_HOST=127.0.0.1

COMPOSE_REDIS_IMAGE=redis:7-alpine
COMPOSE_REDIS_PASSWORD=CHANGE_ME_CACHE_PASSWORD
COMPOSE_REDIS_BIND_ADDRESS=127.0.0.1
COMPOSE_REDIS_HOST_PORT=6379
